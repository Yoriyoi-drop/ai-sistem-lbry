{
  "dashboard": {
    "id": null,
    "title": "Infinite AI Security Platform Dashboard",
    "tags": ["security", "ai", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"],
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "name": "Service",
          "type": "query",
          "query": "label_values(service)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        },
        {
          "name": "Team",
          "type": "query",
          "query": "label_values(team)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "System Health Overview",
        "type": "stat",
        "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "count(up == 1)",
            "legendFormat": "Healthy Services"
          }
        ],
        "reduceCalc": "lastNotNull",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "title": "Total HTTP Requests",
        "type": "stat",
        "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "sum(increase(http_requests_total[1m]))",
            "legendFormat": "Requests"
          }
        ],
        "reduceCalc": "lastNotNull",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "Security Threats Detected",
        "type": "stat",
        "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(increase(threats_detected_total[5m]))",
            "legendFormat": "Threats"
          }
        ],
        "reduceCalc": "lastNotNull",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 1}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 4,
        "title": "API Response Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95 Response Time"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P50 Response Time"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds",
            "format": "s"
          }
        ]
      },
      {
        "id": 5,
        "title": "Security Scans by Type",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
        "targets": [
          {
            "expr": "sum(rate(security_scans_total[5m])) by (scan_type)",
            "legendFormat": "{{scan_type}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Threats by Severity",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
        "targets": [
          {
            "expr": "sum(rate(threats_detected_total[5m])) by (severity)",
            "legendFormat": "{{severity}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "System Resources",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
        "targets": [
          {
            "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU Usage"
          },
          {
            "expr": "100 - ((node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100)",
            "legendFormat": "Memory Usage"
          }
        ],
        "yAxes": [
          {
            "label": "Percentage",
            "format": "percent"
          }
        ]
      },
      {
        "id": 8,
        "title": "Active Connections",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 21},
        "targets": [
          {
            "expr": "active_connections",
            "legendFormat": "Active Connections"
          }
        ]
      },
      {
        "id": 9,
        "title": "API Error Rate",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 21},
        "targets": [
          {
            "expr": "sum(rate(api_errors_total[5m])) by (error_type)",
            "legendFormat": "{{error_type}}"
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "links": [],
    "gnetId": null,
    "description": "Dashboard for Infinite AI Security Platform monitoring"
  }
}