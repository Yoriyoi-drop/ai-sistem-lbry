# Konfigurasi Environment untuk Infinite AI Security
# Salin file ini ke .env dan sesuaikan nilainya

# Konfigurasi Model
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
TEMPERATURE=0.3
MAX_TOKENS=2000

# Konfigurasi Redis (jika digunakan)
REDIS_HOST=localhost
REDIS_PORT=6379

# Konfigurasi Database (jika digunakan)
DATABASE_URL=sqlite:///./security.db

# Konfigurasi Logging
LOG_LEVEL=INFO
LOG_FILE=security_ai.log

# Konfigurasi Port
API_PORT=8000

# Konfigurasi Keamanan
SECURITY_ENABLED=true
RATE_LIMIT_ENABLED=true