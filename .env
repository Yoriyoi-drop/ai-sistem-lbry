# Konfigurasi untuk Infinite AI Security

# Konfigurasi Model
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
TEMPERATURE=0.3
MAX_TOKENS=2000

# Konfigurasi AI Roles
AI_ROLES="strategist,analyzer,executor,validator,memory,orchestrator,gateway,modelserver"

# Konfigurasi Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Konfigurasi Database
DB_BACKEND=postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=infinite_ai_security
# Alternative: Use DATABASE_URL directly (overwrites individual PG_* settings)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infinite_ai_security

# Konfigurasi Logging
LOG_LEVEL=INFO
LOG_FILE=infinite_ai_security.log

# Konfigurasi Port
API_PORT=8000

# Konfigurasi Keamanan
SECURITY_ENABLED=true
RATE_LIMIT_ENABLED=true

# Konfigurasi Update Otomatis
AUTO_UPDATE=true
UPDATE_INTERVAL=3600  # dalam detik, 1 jam

# Konfigurasi Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400  # dalam detik, 24 jam

# Konfigurasi Monitoring
MONITORING_ENABLED=true
HEALTH_CHECK_INTERVAL=300  # dalam detik, 5 menit